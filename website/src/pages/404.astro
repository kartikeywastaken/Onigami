---
import Base from '../layouts/Base.astro';
---
<Base title="Nothing here" description="This path is out of scope. Go back to the start or open the manual." noindex>
  <main id="main" tabindex="-1" data-well="dry" class="dry">
    <div class="dry__inner">
      <h1 class="dry__title" data-split="lines" data-intro>Out of scope.</h1>
      <pre class="term dry__term"><span class="ln ln--cmd"><span class="prompt">$ </span>onigami --target <span data-path>this page</span></span>
<span class="ln ln--out">onigami: refused, this path is not in scope</span>
<span class="ln ln--dim">exit 1</span></pre>
      <div class="dry__links" data-reveal="fade" data-intro data-delay="0.45">
        <a class="btn" href="/"><span class="btn__fill" aria-hidden="true"></span><span class="btn__label">Back to the start</span></a>
        <a class="u-link" href="/manual/">Open the manual<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
  <script>
    import { onPage } from '../engine';
    onPage(() => {
      const el = document.querySelector('[data-path]');
      if (el) el.textContent = location.pathname;
    });
  </script>
</Base>
