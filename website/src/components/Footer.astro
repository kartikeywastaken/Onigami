---
import Mark from './Mark.astro';
import { site } from '../data/site';
const year = 2026;
---
<footer class="foot" data-layer="content">
  <div class="foot__mark"><Mark /> <span>onigami {site.version}. {site.license} licence. {year}.</span></div>
  <ul class="foot__links">
    <li><a class="u-link" href="/manual/">Manual</a></li>
    <li><a class="u-link" href={site.github} rel="noopener">Source on GitHub</a></li>
    <li><a class="u-link" href="/manual/#files">Where findings live</a></li>
  </ul>
  <p class="foot__colo">For authorized testing only. Set in Martian Mono and Host Grotesk; the eye is a 3D scene drawn live in terminal glyphs.</p>
</footer>
