---
// 鬼 (oni): the demon-kanji at the heart of 鬼神 (onigami). The same glyph the
// terminal dashboard wears. Rendered as SVG text so it inherits currentColor and
// scales with the brand lockup. Replace with a bespoke path for pixel-exact
// consistency across systems if you want it independent of the viewer's CJK font.
interface Props { class?: string; label?: string }
const { class: cls, label } = Astro.props;
---
<svg class={cls} viewBox="0 0 30 32" width="21" height="32" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <text x="15" y="26" text-anchor="middle" font-size="29" font-weight="700" fill="currentColor"
    font-family="'Hiragino Mincho ProN','Yu Mincho','Noto Serif CJK JP','Noto Serif JP',serif">鬼</text>
</svg>
